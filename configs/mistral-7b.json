{
  "_comment": "Reference config for mistralai/Mistral-7B-Instruct-v0.3 (Apache 2.0 license).",
  "model_name": "mistral-7b",
  "base_repo": "mistralai/Mistral-7B-Instruct-v0.3",
  "license": "Apache 2.0",

  "vocab_size": 32768,
  "hidden_size": 4096,
  "intermediate_size": 14336,
  "num_hidden_layers": 32,
  "num_attention_heads": 32,
  "num_key_value_heads": 8,
  "head_dim": 128,
  "max_position_embeddings": 32768,
  "rms_norm_eps": 1e-5,
  "rope_theta": 10000.0,
  "tie_word_embeddings": false,
  "hidden_act": "silu",

  "nathwanigpt_defaults": {
    "temperature": 0.7,
    "top_k": 50,
    "top_p": 0.9,
    "repetition_penalty": 1.1,
    "max_new_tokens": 1024
  }
}
