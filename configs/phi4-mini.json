{
  "_comment": "Reference config for microsoft/Phi-4-mini-instruct (MIT license). Actual values are read from the downloaded config.json — this file is for documentation only.",
  "model_name": "phi4-mini",
  "base_repo": "microsoft/Phi-4-mini-instruct",
  "license": "MIT",

  "vocab_size": 100352,
  "hidden_size": 3072,
  "intermediate_size": 8192,
  "num_hidden_layers": 32,
  "num_attention_heads": 32,
  "num_key_value_heads": 8,
  "head_dim": 96,
  "max_position_embeddings": 131072,
  "rms_norm_eps": 1e-5,
  "rope_theta": 10000.0,
  "tie_word_embeddings": false,
  "hidden_act": "silu",

  "nathwanigpt_defaults": {
    "temperature": 0.7,
    "top_k": 50,
    "top_p": 0.9,
    "repetition_penalty": 1.1,
    "max_new_tokens": 1024
  }
}
